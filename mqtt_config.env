# MQTT broker connection
BROKER="86.50.230.34"
PORT=1883
USERNAME="mqtt_tello"
PASSWD="tello"

# Button publishes here; drone controller subscribes here
TOPIC="restaurant/tello/commands/start-mission"

# Drone controller publishes detection events here
EVENT_TOPIC="restaurant/tello/events/customer-detected"

# Each script must use its own client ID
DETECTION_CLIENT_ID="tello-drone-table-detection"
BUTTON_CLIENT_ID="tello-button-start-mission"